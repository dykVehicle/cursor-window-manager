{
  "name": "cursor-window-manager",
  "version": "1.0.0",
  "description": "跨平台Cursor多窗口管理工具 - 支持自由切分窗口、拖动调整布局",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "vite",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "start": "cross-env NODE_ENV=development electron .",
    "start:prod": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "com.cursor.window-manager",
    "productName": "Cursor Window Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/main/embedWindow.ps1",
        "to": "embedWindow.ps1"
      }
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/multi-cursor-logo.png",
      "category": "Development;Utility",
      "maintainer": "dyk <dyk@example.com>"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "homepage": "https://github.com/dyk/cursor-window-manager",
  "keywords": [
    "cursor",
    "window-manager",
    "multi-window",
    "electron"
  ],
  "author": {
    "name": "dyk",
    "email": "dyk@example.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.42",
    "@types/react-dom": "^18.2.17",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.2",
    "vite": "^5.0.6"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "koffi": "^2.15.1",
    "node-window-manager": "^2.2.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-mosaic-component": "^6.1.0",
    "uuid": "^9.0.1"
  }
}
